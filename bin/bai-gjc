#!/usr/bin/env bash
# bai-gjc — run gjc with the B.AI starter profile (~/.gjc-bai/agent).
# main + subagents = B.AI (one key: BAI_API_KEY). Bare `gjc` keeps using ~/.gjc/agent, untouched.
#
# GJC_CODING_AGENT_DIR moves only the user agent dir (config.yml, models.yml,
# sessions, auth db). Project folders keep using `.gjc/`, so repo-local skills,
# rules and settings still load.
set -euo pipefail
if [ -z "${BAI_API_KEY:-}" ]; then
  echo "BAI_API_KEY 가 비어 있습니다. https://chat.b.ai/chat 에서 키 발급 후:" >&2
  echo '  export BAI_API_KEY="sk-..."   (README 참고)' >&2
  exit 1
fi
export GJC_CODING_AGENT_DIR="${GJC_BAI_AGENT_DIR:-$HOME/.gjc-bai/agent}"
unset PI_CODING_AGENT_DIR GJC_CONFIG_DIR PI_CONFIG_DIR
# Reasoning models + long context can exceed gjc's default 100s first-token watchdog.
export PI_STREAM_FIRST_EVENT_TIMEOUT_MS="${PI_STREAM_FIRST_EVENT_TIMEOUT_MS:-300000}"
export PI_STREAM_IDLE_TIMEOUT_MS="${PI_STREAM_IDLE_TIMEOUT_MS:-180000}"
# Scrub inherited paid-provider creds so this profile never bills them by accident.
while IFS='=' read -r _n _; do
  case "$_n" in ANTHROPIC_*|OPENAI_API_KEY|OPENAI_BASE_URL|OPENROUTER_API_KEY) unset "$_n" || true ;; esac
done < <(env)
exec gjc "$@"
